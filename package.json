{
  "name": "entgegen-bibelstudium",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interaktive Bibelstudium-Anwendung mit historischem Kontext und Auslegungshilfen",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "build:data": "node scripts/build-bible-data.mjs",
    "build:single": "node scripts/build-singlefile.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vite-plugin-pwa": "^1.3.0"
  }
}
